.gitattributes export-ignore
.github export-ignore
release-line.txt export-ignore
tools/package-release.sh export-ignore

# These inputs are byte-sensitive and must not be rewritten by Windows Git.
/contracts/content-v1/** text eol=lf
/maps/** text eol=lf
/prototypes/authored-syntax-v1/** text eol=lf
/tools/syntax_evaluation/** text eol=lf
*.png filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
