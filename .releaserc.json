{
  "branches": ["+([0-9]).+([0-9]).x", "main"],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", {"preset": "conventionalcommits", "releaseRules": "./scripts/release/release-rules.cjs"}],
    ["@semantic-release/release-notes-generator", {"preset": "conventionalcommits"}],
    ["@semantic-release/exec", {"publishCmd": "tools/build-release-assets.sh ${nextRelease.version}", "successCmd": "node scripts/release/verify-release.cjs ${nextRelease.version} ${nextRelease.gitHead}"}],
    ["@semantic-release/github", {"assets": [{"path": "build/release/*"}], "successCommentCondition": false}]
  ]
}
