{
  "schema_version": 1,
  "grammar_id": "atrinik-legacy-ads-v1",
  "authority": {
    "object_loader": "atrinik/server:src/loaders/object.l",
    "map_header_loader": "atrinik/server:src/loaders/map_header.l",
    "object_writer": "atrinik/server:src/loaders/object.l#get_ob_diff",
    "map_writer": "atrinik/server:src/server/map.c#new_save_map"
  },
  "encoding": {
    "character_encoding": "UTF-8-compatible bytes; legacy C loaders are byte-oriented",
    "accepted_line_endings": ["crlf", "lf"],
    "canonical_writer_line_ending": "lf",
    "comments": "A line whose first byte is # is ignored by the server Flex loaders",
    "field_separator": "one or more spaces or tabs; values retain internal spaces",
    "field_casing": "ASCII case-insensitive in server Flex loaders (-i); other consumers differ",
    "terminal_newline": "accepted by some load modes but emitted by every server writer"
  },
  "object_grammar": {
    "openers": ["arch NAME", "Object NAME"],
    "closer": "end",
    "message": {"opener": "msg", "closer": "endmsg", "body": "raw lines"},
    "multipart_separator": "More",
    "maximum_nesting_depth": 10,
    "nesting_limit_scope": "line-mode has ten object stack entries; Flex-buffer and NUL-string modes recurse without an explicit grammar depth bound",
