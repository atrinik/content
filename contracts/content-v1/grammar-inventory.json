  "load_modes": [
    {
      "name": "MAP_ARTIFACT",
      "entry_point": "load_object",
      "observable_difference": "applies an artifact template and stable spell/skill identity validation"
    },
    {
      "name": "MAP_ORIGINAL",
      "entry_point": "load_object_buffer",
      "observable_difference": "loads authored map objects and performs auto-apply or treasure generation"
    },
    {
      "name": "MAP_STYLE",
      "entry_point": "load_object_fp",
      "observable_difference": "loads archetype/style records without runtime initialization side effects"
    },
    {
      "name": "flex-buffer-mode",
      "entry_point": "load_object_buffer",
      "observable_difference": "scans the active Flex buffer and recursively consumes nested arch blocks"
    },
    {
      "name": "line-mode",
      "entry_point": "load_object_fp",
      "observable_difference": "feeds one FILE line at a time and maintains nested inventory depth in the caller"
    },
    {
      "name": "map-header-mode",
      "entry_point": "load_map_header/map_lex_load",
      "observable_difference": "requires the exact initial arch map LF sentinel before scanning header fields and messages"
    },
    {
      "name": "map-single-variable-mode",
      "entry_point": "map_set_variable",
      "observable_difference": "scans one map-header record without requiring the arch map sentinel"
    },
    {
      "name": "nul-string-mode",
      "entry_point": "load_object",
      "observable_difference": "recursively scans NUL-separated object strings"
    },
    {
      "name": "object-single-variable-mode",
      "entry_point": "set_variable",
      "observable_difference": "applies one plugin-provided object field through the shared Flex rules"
    }
  ],
  "required_corpus_features": [
    "attribution",
    "comments",
    "crlf",
    "custom-fields",
    "exits",
    "lf",
    "malformed",
    "mixed-line-endings",
    "multiline-messages",
    "multipart",
    "nested-inventory",
    "no-terminal-newline",
    "stable-identities",
    "stacked-objects",
    "tiled-maps",
    "unknown-fields"
  ]
}
