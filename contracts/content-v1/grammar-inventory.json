  "map_header_grammar": {
    "opener": "arch map",
    "closer": "end",
    "message": {"opener": "msg", "closer": "endmsg", "body": "raw lines"},
    "tile_field_pattern": "^tile_path_[0-9]{1,2}$",
    "unknown_field_behavior": "server logs and ignores the record while the outer line loader continues; legacy checkers retain arbitrary keys",
    "known_fields": [
      "bg_music",
      "darkness",
      "difficulty",
      "enter_x",
      "enter_y",
      "fixed_login",
      "fixed_resettime",
