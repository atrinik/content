{
  "schema_version": 1,
  "max_input_bytes": 67108864,
  "max_depth": 64,
  "max_nodes": 1000000,
  "max_collection_items": 250000,
  "max_object_keys": 256,
  "max_string_bytes": 1048576,
  "max_number_bytes": 128,
  "max_safe_integer": 9007199254740991,
  "max_comments": 100000,
  "max_comment_bytes": 4194304,
  "max_line_bytes": 1048576,
